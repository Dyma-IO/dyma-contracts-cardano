use dyma/math.{bps_of, distribute_all, finalize_snapshot}

/// appendix-b-1: spec Appendix B #1, §7.5 table row 1
test vector_appendix_b_1() {
  let snapshot = finalize_snapshot(1000000000, 0, 10000)
  let result = distribute_all(
    snapshot.distributable,
    [50, 30, 20],
    snapshot.cap,
    0,
  )
  and {
    snapshot.distributable == 1000000000,
    snapshot.cap == 1000000000,
    result.amounts == [500000000, 300000000, 200000000],
    result.skipped == 0,
    result.leftover == 0,
    bps_of(result.paid_total, 0) == 0,
    1000000000 - result.paid_total - bps_of(result.paid_total, 0) == 0,
  }
}

